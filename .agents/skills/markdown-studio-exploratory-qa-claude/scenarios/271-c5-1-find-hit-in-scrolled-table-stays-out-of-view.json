{"name": "c5-1-find-hit-in-scrolled-table-stays-out-of-view", "file": "synth/c5-reading.md", "steps": [{"open": "${file}", "wait": 2500}, {"palette": "Markdown OKF-Schema Studio: Open Preview to Side", "wait": 4000, "optional": true}, {"waitFor": "[...D.querySelectorAll('td')].some(t=>t.textContent.includes('needle'))", "timeout": 20000}, {"comment": "Edit mode keeps whole words, so the Description column is wide and the table scrolls sideways."}, {"eval": "D.documentElement.getAttribute('data-sphinx-preview-edit-mode')", "max": 20}, {"editMode": true, "optional": true}, {"waitFor": "D.documentElement.getAttribute('data-sphinx-preview-edit-mode')==='on'"}, {"clicksel": "td", "text": "carol", "exact": true, "wait": 300}, {"key": "Escape", "wait": 300}, {"check": "feval", "expr": "D.querySelector('table').scrollLeft > 100", "label": "table scrolled to the Owner column"}, {"key": "Meta+f", "wait": 600}, {"type": "needle", "delay": 40}, {"key": "Enter", "wait": 800}, {"check": "feval", "expr": "(()=>{const td=[...D.querySelectorAll('td')].find(t=>t.textContent.includes('needle'));const n=td.firstChild;const g=D.createRange();g.setStart(n,0);g.setEnd(n,6);const r=g.getBoundingClientRect();return r.left>=0&&r.right<=W.innerWidth})()", "label": "c5-1 the find hit text (needle) is inside the visible part of the preview"}, {"shot": "c5-1-currently", "clip": "preview"}]}