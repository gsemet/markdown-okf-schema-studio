{
  "name": "table-cell-edit",
  "file": "synth/tables.md",
  "vars": {"cell": "beta", "typed": " X"},
  "steps": [
    {"mark": true},
    {"editMode": true},
    {"clicksel": "td", "text": "${cell}", "exact": true},
    {"waitFor": "D.querySelector('[data-sphinx-preview-table-cell-editor] textarea')", "label": "cell editor"},
    {"key": "End"},
    {"type": "${typed}"},
    {"key": "Enter", "wait": 900},
    {"check": "diff", "against": "mark", "maxLines": 1, "contains": "${cell}${typed}"},
    {"check": "feval", "expr": "!D.querySelector('[data-sphinx-preview-table-cell-editor]')", "label": "cell editor closed"},
    {"check": "errors"},
    {"shot": "table-cell-edit-fail", "clip": "preview", "onFail": true}
  ]
}
