{
 "name": "ux-12-cell-edit-minimal-diff",
 "file": "fixtures-visual/04-code-and-tables.md",
 "vars": {},
 "steps": [
  {
   "open": "${file}"
  },
  {
   "palette": "File: Revert File",
   "wait": 800
  },
  {
   "palette": "Markdown OKF-Schema Studio: Open Preview to Side",
   "wait": 4000
  },
  {
   "waitFor": "D.querySelector(\"h1, h2, p\")",
   "timeout": 15000
  },
  {
   "editMode": true
  },
  {
   "mark": true
  },
  {
   "clicksel": "td",
   "text": "North",
   "exact": true,
   "nth": 1
  },
  {
   "key": "End"
  },
  {
   "type": " Pole",
   "delay": 20
  },
  {
   "key": "Enter"
  },
  {
   "wait": 1200
  },
  {
   "check": "diff",
   "against": "mark",
   "maxLines": 1,
   "show": true,
   "label": "UX-12 one line changed"
  },
  {
   "shot": "ux-12",
   "clip": "preview",
   "onFail": true
  }
 ]
}