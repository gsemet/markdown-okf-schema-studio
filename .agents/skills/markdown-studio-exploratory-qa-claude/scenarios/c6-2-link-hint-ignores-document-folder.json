{
  "name": "c6-2-link-hint-ignores-document-folder",
  "file": "synth/frontmatter-edge.md",
  "vars": {},
  "steps": [
    {"open": "${file}"},
    {"palette": "Markdown OKF-Schema Studio: Open Preview to Side", "wait": 4000},
    {"waitFor": "D.querySelector('tr[data-okf-field=related]')", "timeout": 15000},
    {"editMode": true},
    {"check": "feval", "expr": "!!D.querySelector('tr[data-okf-field=related] a[href*=\"related-target\"]') && !/File not found/.test(D.querySelector('tr[data-okf-field=related] li, tr[data-okf-field=related] td[data-okf-value-cell]').textContent.split('missing')[0])", "label": "c6-2 table resolves related-target.md next to the document"},
    {"clicksel": "tr[data-okf-field=related] td[data-okf-value-cell]"}, {"wait": 700},
    {"clicksel": "input[aria-label='List item 1']"}, {"key": "End"}, {"type": "x"}, {"key": "Backspace"}, {"wait": 600},
    {"check": "feval", "expr": "!/No Markdown file named/.test(Array.from(D.querySelectorAll('[data-state][data-visible=true]')).map(e=>e.textContent).join('/'))", "label": "c6-2 editor hint does not say 'not found' for a value the table resolves"},
    {"key": "Escape"},
    {"shot": "c6-2", "clip": "preview", "onFail": true}
  ]
}
