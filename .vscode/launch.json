{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension: Markdown OKF-Schema Studio",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "sourceMaps": true
    }
  ]
}
